{
  "name": "hamak-database",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed data, and database reports for Hamak AI & Robotics Club",
  "scripts": {
    "start": "node src/server.js",
    "db:check-node": "node scripts/check-prisma-node.js",
    "db:validate": "node scripts/check-prisma-node.js && prisma validate",
    "db:generate": "node scripts/check-prisma-node.js && prisma generate",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate",
    "db:migrate:deploy": "node scripts/check-prisma-node.js && prisma migrate deploy",
    "db:seed": "node scripts/check-prisma-node.js && prisma db seed",
    "auth:create-user": "node scripts/provision-user.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0 || >=22.12.0 <23.0.0 || >=24.0.0 <25.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "prisma": "7.10.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pg": "8.16.3",
    "dotenv": "16.6.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
