# PostgreSQL connection used by the API and Prisma migrations.
DATABASE_URL=postgresql://hamak:CHANGE_ME@127.0.0.1:5432/hamak?schema=public

# HTTP server
PORT=3000
NODE_ENV=production

# Exact browser origin allowed to call this API. Use the frontend's scheme and
# host only (no path), for example https://inventory.example.com.
FRONTEND_URL=https://frontend.example.com

# Optional ISO-8601 event end timestamp, including timezone.
HACKATHON_END_AT=

# Authentication uses opaque bearer session tokens stored as SHA-256 hashes.
# No SESSION_SECRET is currently required; a trusted authentication service
# must issue the tokens and create/manage their database sessions.
